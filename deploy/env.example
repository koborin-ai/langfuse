# Template for the `langfuse-env` secret in Secret Manager. Keys only; never
# commit real values. bin/up.sh renders this secret (plus TUNNEL_TOKEN from
# the Terraform-managed `cloudflared-token` secret) into deploy/.env on the VM.
#
# Generate every secret below with `openssl rand -hex 32`. Hex keeps
# DATABASE_URL valid without URL-escaping.

NEXTAUTH_URL=https://langfuse.koborin.ai
NEXTAUTH_SECRET=
# Losing SALT or ENCRYPTION_KEY breaks stored API key hashes and encrypted
# LLM credentials. Keep an offline copy (e.g. 1Password).
SALT=
ENCRYPTION_KEY=

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# Cloudflare R2. Endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BLOB_BUCKET=langfuse-blob
# R2 API token scoped to Object Read & Write on `langfuse-blob` only.
R2_BLOB_ACCESS_KEY_ID=
R2_BLOB_SECRET_ACCESS_KEY=
# R2 API token scoped to Object Read & Write on `langfuse-backups` only.
R2_BACKUP_BUCKET=langfuse-backups
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Auth. Sign-up stays closed; see README "First login".
AUTH_DISABLE_SIGNUP=true
AUTH_DISABLE_USERNAME_PASSWORD=false
# GitHub OAuth App callback: https://langfuse.koborin.ai/api/auth/callback/github
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Google OAuth client callback: https://langfuse.koborin.ai/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Headless init: creates the org, project, API keys, and admin user on first
# boot. Safe to leave set; existing resources are not overwritten.
LANGFUSE_INIT_ORG_ID=koborin-ai
LANGFUSE_INIT_ORG_NAME=koborin.ai
LANGFUSE_INIT_PROJECT_ID=showcase
LANGFUSE_INIT_PROJECT_NAME=showcase
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

TELEMETRY_ENABLED=false
